<brls:Box
    width="auto"
    height="auto"
    focusable="true"
    paddingLeft="20"
    paddingRight="20"
    paddingTop="14"
    paddingBottom="14"
    alignItems="center">

    <brls:Box
        grow="1.0"
        axis="column"
        justifyContent="center">

        <brls:Label
            id="name"
            fontSize="22"
            singleLine="true" />

        <brls:Label
            id="subtitle"
            fontSize="16"
            marginTop="2"
            singleLine="true" />

    </brls:Box>

</brls:Box>
