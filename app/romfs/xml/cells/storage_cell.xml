<brls:Box
    width="auto"
    height="auto"
    focusable="true"
    paddingLeft="20"
    paddingRight="20"
    paddingTop="12"
    paddingBottom="12"
    alignItems="center">

    <brls:Box
        grow="1.0"
        axis="column"
        justifyContent="center">

        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            alignItems="center">

            <brls:Label
                id="title"
                fontSize="22"
                grow="1.0"
                singleLine="true" />

            <brls:Label
                id="size"
                fontSize="18"
                marginLeft="10"
                singleLine="true" />

        </brls:Box>

        <brls:Label
            id="subtitle"
            fontSize="16"
            marginTop="2"
            singleLine="true" />

        <brls:Box
            id="bar"
            width="auto"
            height="auto"
            marginTop="8" />

    </brls:Box>

</brls:Box>
